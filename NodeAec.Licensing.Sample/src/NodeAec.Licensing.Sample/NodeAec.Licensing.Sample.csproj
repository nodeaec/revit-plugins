<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NodeAec.Licensing.Sample</RootNamespace>
    <AssemblyName>NodeAec.Licensing.Sample</AssemblyName>
    <Description>Node.aec partner plugin integration sample using Micro-SDK NodeAecGate.</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API assemblies are provided by Revit at runtime: reference-only, never copied. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPkgVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPkgVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitApiPkgVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Versão derivada do TFM; vazia em net10.0-windows, que já traz o DPAPI na caixa. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="$(DpapiPkgVersion)" Condition="'$(DpapiPkgVersion)' != ''" />
    <!-- Verificação Ed25519 (RFC 8032) do lease local — mesma versão usada pelo Node.aec Connector. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
